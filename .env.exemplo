# Copie para .env (fora do git) e preencha. Usado pelo docker-compose.prod.yml.

# Endereço público: com o Elastic IP 1.2.3.4, use 1-2-3-4.sslip.io (HTTPS automático pelo Caddy)
DOMINIO=localhost

# RDS PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://<endpoint-do-rds>:5432/resgatai
SPRING_DATASOURCE_USERNAME=resgatai
SPRING_DATASOURCE_PASSWORD=

# Mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=

# Administrador criado na primeira subida
ADMIN_EMAIL=
ADMIN_SENHA=

# Sem SMTP as notificações ficam só na caixa de entrada do app. Para enviar e-mails, acrescente
# SPRING_MAIL_HOST, SPRING_MAIL_PORT, SPRING_MAIL_USERNAME, SPRING_MAIL_PASSWORD e MAIL_REMETENTE
# aqui e no environment do backend em docker-compose.prod.yml.
